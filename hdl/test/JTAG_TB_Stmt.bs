package JTAG_TB_Stmt (
    jtag_sequence_hidden,
    jtag_sequence_ret_hidden
) where

import List
import StmtFSM

-- JTAG_TB.bsv presents scan helpers as plain functions which return Stmt
-- values.  The caller should not have to instantiate a scratch counter or shift
-- register just to run a scan in a test FSM.
--
-- Bluespec's Stmt type is really a StmtM value.  In the standard library that
-- monad is backed by Module, and the S constructor lets us provide the Module
-- action which builds the statement.  Writing this helper in .bs gives direct
-- access to that constructor, so we can allocate private mkRegU state here while
-- still exporting an ordinary BSV-callable function.
--
-- The resulting hardware is instantiated when the surrounding mkFSM elaborates
-- the returned Stmt.  Each scan helper below therefore owns its private shift
-- registers, and the public testbench API stays context-free.
--
-- The loop uses StmtFSM's SRepeat node.  SRepeat has its own implementation
-- counter inside the generated FSM, which avoids recursively unrolling one
-- action pair per JTAG bit at compile time.  There is a known trap with repeat
-- bodies that can block while also updating the repeat counter.  These scan
-- bodies only drive wires/registers and sample TDO, so they do not rely on that
-- blocking behavior.

jtag_capture_next_hidden :: (Add w1 1 w) => Bit w -> Bit 1 -> Bit w
jtag_capture_next_hidden current tdo =
    let next_msb :: Bit w
        next_msb = (zeroExtend tdo) << (valueOf w1)
    in (current >> 1) | next_msb

-- tms_vec and tdi_vec use the original JTAG_TB convention: the first scan bit
-- is the MSB of the argument.  Internally we reverse the vectors once, then each
-- repeat iteration can drive bit 0 and shift right.  This keeps the generated
-- loop small and preserves the old visible scan ordering.
--
-- Each iteration has a low phase and a high phase.  TMS/TDI are held stable in
-- both phases; the shift registers advance during the high phase after the bit
-- has been presented on TCK=1.
jtag_sequence_hidden :: Wire (Bit 1) -> Wire (Bit 1) -> Wire (Bit 1) -> Bit w -> Bit w -> Stmt
jtag_sequence_hidden tck tms tdi tms_vec tdi_vec =
    S $
    module
        tms_shift :: Reg (Bit w)
        tms_shift <- mkRegU
        tdi_shift :: Reg (Bit w)
        tdi_shift <- mkRegU

        let load = SAction noPosInfo
                   action {
                       tms_shift := reverseBits tms_vec;
                       tdi_shift := reverseBits tdi_vec
                   }
                   Nothing
            low = SAction noPosInfo
                  action {
                      tck._write 0;
                      tms._write tms_shift[0:0];
                      tdi._write tdi_shift[0:0]
                  }
                  Nothing
            high = SAction noPosInfo
                   action {
                       tck._write 1;
                       tms._write tms_shift[0:0];
                       tdi._write tdi_shift[0:0];
                       tms_shift := tms_shift >> 1;
                       tdi_shift := tdi_shift >> 1
                   }
                   Nothing
            body = SSeq noPosInfo (Cons low (Cons high Nil))
            loop = SRepeat noPosInfo (fromInteger (valueOf w)) body

        return ((), Cons load (Cons loop Nil))

-- This is the readback variant.  The scan itself can be wider than the captured
-- value, so sw is the scan width and w is the output register width.  The Add
-- proviso gives jtag_capture_next_hidden the index of the output MSB.
--
-- capture_vec follows the same MSB-first scan order as tms_vec/tdi_vec.  A set
-- capture bit means "sample TDO during this high phase".  Captured bits enter
-- the result register at the MSB and shift right on each captured sample; after
-- w samples, the first sampled TDO bit has naturally moved to bit 0.  That
-- matches the previous indexed testbench implementation.
jtag_sequence_ret_hidden :: (Add w1 1 w) =>
                            Wire (Bit 1) -> Wire (Bit 1) -> Wire (Bit 1) -> Wire (Bit 1) ->
                            Bit sw -> Bit sw -> Bit sw -> Reg (Bit w) -> Stmt
jtag_sequence_ret_hidden tck tms tdi tdo tms_vec tdi_vec capture_vec out =
    S $
    module
        tms_shift :: Reg (Bit sw)
        tms_shift <- mkRegU
        tdi_shift :: Reg (Bit sw)
        tdi_shift <- mkRegU
        capture_shift :: Reg (Bit sw)
        capture_shift <- mkRegU

        let load = SAction noPosInfo
                   action {
                       tms_shift := reverseBits tms_vec;
                       tdi_shift := reverseBits tdi_vec;
                       capture_shift := reverseBits capture_vec
                   }
                   Nothing
            low = SAction noPosInfo
                  action {
                      tck._write 0;
                      tms._write tms_shift[0:0];
                      tdi._write tdi_shift[0:0]
                  }
                  Nothing
            high = SAction noPosInfo
                   action {
                       tck._write 1;
                       tms._write tms_shift[0:0];
                       tdi._write tdi_shift[0:0];
                       if capture_shift[0:0] == 1
                          then out := jtag_capture_next_hidden out tdo
                          else noAction;
                       tms_shift := tms_shift >> 1;
                       tdi_shift := tdi_shift >> 1;
                       capture_shift := capture_shift >> 1
                   }
                   Nothing
            body = SSeq noPosInfo (Cons low (Cons high Nil))
            loop = SRepeat noPosInfo (fromInteger (valueOf sw)) body

        return ((), Cons load (Cons loop Nil))
